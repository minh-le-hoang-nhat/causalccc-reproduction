+// Early decision of the confidence cut.
+// confidenceCut() removes an edge when exp(-I') / E > conf_threshold, where
+// I' = Ixy_ui - kxy_ui and E = mean over the n shuffles of exp(-I'_shuffle).
+// Every term exp(-I'_shuffle) is in ]0, 1] (I'_shuffle is set to 0 when
+// negative), so after m shuffles summing to S:  S / n <= E <= (S + n - m) / n.
+// As soon as one of the two bounds settles the decision, the edge is decided
+// and its remaining shuffles are not computed. exp_shuffle then stores that
+// bound, so that confidenceCut() reaches the same decision as with all the
+// shuffles. Shuffles are still drawn for every edge, so the random number
+// stream is unchanged.
+namespace {
+
+struct ShuffleSum {
+  double sum{0};      // sum of exp(-I'_shuffle) over the shuffles done
+  int n_done{0};      // number of shuffles done
+  bool decided{false};
+  double value{0};    // exp_shuffle stored once decided
+};
+
+// The same expression as in confidenceCut()
+bool isCut(double I_prime_original, double exp_shuffle, double threshold) {
+  return exp(-I_prime_original) / exp_shuffle > threshold;
+}
+
+void tryToDecide(ShuffleSum& s, double I_prime_original, int n_shuffles,
+    double threshold) {
+  double lower = s.sum / n_shuffles;
+  double upper = (s.sum + n_shuffles - s.n_done) / n_shuffles;
+  if (s.n_done > 0 && !isCut(I_prime_original, lower, threshold)) {
+    s.decided = true;  // kept whatever the remaining shuffles give
+    s.value = lower;
+  } else if (isCut(I_prime_original, upper, threshold)) {
+    s.decided = true;  // cut whatever the remaining shuffles give
+    s.value = upper;
+  }
+}
+
+}  // anonymous namespace
+
